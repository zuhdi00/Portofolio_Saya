  <property name="styleSheet">
   <string notr="true">
/* === GLOBAL === */
QDialog {
    background-color: #F0F4F8;
    font-family: &quot;Segoe UI&quot;, sans-serif;
}

/* === HEADER PANEL === */
#headerFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1A6B8A, stop:1 #0D4F6E);
    border-radius: 0px;
}

#lblTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1px;
}

#lblSubtitle {
    color: #A8D8EA;
    font-size: 10px;
}

/* === BERAT TIMBANG DISPLAY === */
#beratFrame {
    background-color: #FFFFFF;
    border: 2px solid #1A6B8A;
    border-radius: 8px;
}

#lblBeratValue {
    color: #0D4F6E;
    font-size: 36px;
    font-weight: bold;
    qproperty-alignment: AlignCenter;
}

#lblBeratUnit {
    color: #6B7A8D;
    font-size: 12px;
    qproperty-alignment: AlignCenter;
}

/* === FORM CARD === */
#formCard {
    background-color: #FFFFFF;
    border-radius: 10px;
    border: 1px solid #D8E2EC;
}

/* === LABELS === */
QLabel#lblField {
    color: #374151;
    font-size: 11px;
    font-weight: 600;
}

/* === LINE EDIT === */
QLineEdit {
    background-color: #F8FAFC;
    border: 1.5px solid #CBD5E0;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
    color: #1A202C;
    selection-background-color: #1A6B8A;
}
QLineEdit:focus {
    border-color: #1A6B8A;
    background-color: #EBF4F8;
}
QLineEdit:read-only {
    background-color: #EDF2F7;
    color: #4A5568;
}

/* === DATE EDIT === */
QDateEdit {
    background-color: #F8FAFC;
    border: 1.5px solid #CBD5E0;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
    color: #1A202C;
}
QDateEdit:focus {
    border-color: #1A6B8A;
}
QDateEdit::drop-down {
    border: none;
    width: 22px;
}
QDateEdit::down-arrow {
    width: 12px;
    height: 12px;
}

/* === COMBO BOX === */
QComboBox {
    background-color: #F8FAFC;
    border: 1.5px solid #CBD5E0;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
    color: #1A202C;
}
QComboBox:focus {
    border-color: #1A6B8A;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    border: 1px solid #CBD5E0;
    selection-background-color: #1A6B8A;
    selection-color: white;
    background: white;
}

/* === RADIO BUTTON === */
QRadioButton {
    font-size: 11px;
    color: #374151;
    spacing: 5px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #CBD5E0;
    border-radius: 7px;
    background: white;
}
QRadioButton::indicator:checked {
    background-color: #1A6B8A;
    border-color: #1A6B8A;
}

/* === CHECK BOX === */
QCheckBox {
    font-size: 11px;
    color: #374151;
    spacing: 5px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #CBD5E0;
    border-radius: 3px;
    background: white;
}
QCheckBox::indicator:checked {
    background-color: #1A6B8A;
    border-color: #1A6B8A;
}

/* === DIVIDER LINE === */
#dividerLine {
    color: #E2E8F0;
}

/* === NAV BUTTONS === */
#navFrame {
    background-color: #EDF2F7;
    border-radius: 6px;
    border: 1px solid #CBD5E0;
}

QPushButton#btnNav {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #CBD5E0;
    border-radius: 4px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 500;
    min-width: 60px;
}
QPushButton#btnNav:hover {
    background-color: #E2E8F0;
    border-color: #94A3B8;
}
QPushButton#btnNav:pressed {
    background-color: #CBD5E0;
}

/* === ACTION BUTTONS === */
QPushButton#btnTambah {
    background-color: #2D7D9A;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#btnTambah:hover { background-color: #1A6B8A; }
QPushButton#btnTambah:pressed { background-color: #0D4F6E; }

QPushButton#btnSimpan {
    background-color: #27AE60;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#btnSimpan:hover { background-color: #219A52; }
QPushButton#btnSimpan:pressed { background-color: #1A7A42; }

QPushButton#btnEdit {
    background-color: #F39C12;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#btnEdit:hover { background-color: #D68910; }
QPushButton#btnEdit:pressed { background-color: #B7770D; }

QPushButton#btnBatal {
    background-color: #E74C3C;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#btnBatal:hover { background-color: #CB4335; }
QPushButton#btnBatal:pressed { background-color: #A93226; }

QPushButton#btnCetak {
    background-color: #5C6BC0;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#btnCetak:hover { background-color: #4A58B0; }
QPushButton#btnCetak:pressed { background-color: #3949A0; }
