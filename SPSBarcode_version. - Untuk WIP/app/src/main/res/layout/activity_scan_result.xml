<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scanResultLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menunggu hasil..."
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </ScrollView>

    <!-- Label Keterangan -->
    <TextView
        android:id="@+id/labelKeterangan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keterangan :"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:layout_marginTop="16dp"/>

    <!-- TextBox Keterangan -->
    <EditText
        android:id="@+id/editKeterangan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@android:color/white"
        android:hint="Masukkan keterangan"
        android:minHeight="48dp"
        android:textColor="#000000" />

    <!-- Label & Input untuk nBerat2 -->
    <TextView
        android:id="@+id/labelNBerat2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Berat (nBerat2) :"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/editNBerat2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@android:color/white"
        android:hint="Masukkan berat (mis. 12.5)"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        android:textColor="#000000" />
    <Button
        android:id="@+id/btnEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnApproval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Approval"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tolak WIP"
        android:layout_marginTop="16dp"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF" />

</LinearLayout>
